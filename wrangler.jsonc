{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webauthnapi-passkeys-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Only reachable through service bindings from other Workers on the account
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "CHALLENGES", "class_name": "ChallengeStore" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webauthnapi-passkeys-dev",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    },
    {
      "binding": "webauthnapi_passkeys_dev",
      "database_name": "webauthnapi-passkeys-dev",
      "database_id": "5265d4b8-ba4c-4307-b483-18b7d250169b"
    }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChallengeStore"] }]
}
